<Window x:Class="CybersecurityChatbot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Chatbot" Height="780" Width="1000" 
        Background="#2D2D30" Foreground="White" WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10">
            <TextBlock Text="CYBERSECURITY AWARENESS CHATBOT" FontSize="22" FontWeight="Bold" 
                       Foreground="#00CED1" TextAlignment="Center"/>
            <TextBlock x:Name="AsciiArtTextBlock" FontFamily="Courier New" FontSize="11" 
                       Foreground="#FFFFFF" TextAlignment="Center" Margin="0,5"/>
        </StackPanel>

        <TabControl Grid.Row="1" Background="#1E1E1E" BorderBrush="#00CED1">

            <!--  My Chatbot Tab -->
            <TabItem Header="Chatbot">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border BorderBrush="#00CED1" BorderThickness="1" CornerRadius="5" Padding="8" Background="#1E1E1E">
                        <ScrollViewer x:Name="ChatScrollViewer" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ChatStackPanel"/>
                        </ScrollViewer>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBox x:Name="UserInputTextBox" Width="680" Height="38" FontSize="14" 
                                 Margin="0,0,10,0" KeyDown="UserInputTextBox_KeyDown"/>
                        <Button Content="Send" Width="110" Height="38" Click="SendButton_Click" 
                                Background="#00CED1" Foreground="White" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!--  My Task Assistant Tab -->
            <TabItem Header="Task Assistant">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="Add New Task" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Title" Margin="0,5,0,2"/>
                        <TextBox x:Name="txtTaskTitle" Height="32" Margin="0,0,0,8"/>
                        <TextBlock Text="Description" Margin="0,5,0,2"/>
                        <TextBox x:Name="txtTaskDescription" Height="90" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock Text="Reminder (optional)" Margin="0,5,0,2"/>
                        <TextBox x:Name="txtReminder" Height="32" Margin="0,0,0,12"/>
                        <Button x:Name="btnAddTask" Content="Add Task" Click="btnAddTask_Click" 
                                Background="#00CED1" Foreground="White" Height="38" FontWeight="Bold"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Your Tasks" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <ListView x:Name="lvTasks" Height="420" Margin="5">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Title" Width="200" DisplayMemberBinding="{Binding Title}"/>
                                    <GridViewColumn Header="Description" Width="220" DisplayMemberBinding="{Binding Description}"/>
                                    <GridViewColumn Header="Reminder" Width="140" DisplayMemberBinding="{Binding Reminder}"/>
                                    <GridViewColumn Header="Status" Width="80" DisplayMemberBinding="{Binding IsComplete}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                            <Button x:Name="btnMarkComplete" Content="Mark Complete" Click="btnMarkComplete_Click" Width="140" Margin="5"/>
                            <Button x:Name="btnDeleteTask" Content="Delete Task" Click="btnDeleteTask_Click" Width="140" Margin="5"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!--  My Cybersecurity Quiz Tab -->
            <TabItem Header="Cybersecurity Quiz">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="txtQuestion" TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold" 
                               Margin="0,0,0,20" Grid.Row="0"/>

                    <StackPanel x:Name="OptionsPanel" Grid.Row="1" Margin="0,0,0,25"/>

                    <TextBlock x:Name="txtFeedback" Grid.Row="2" TextWrapping="Wrap" FontSize="15" 
                               Foreground="#00FFAA" Margin="0,10"/>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Start Quiz" Click="btnStartQuiz_Click" Width="150" Height="45" Margin="8" FontWeight="Bold"/>
                        <Button x:Name="btnSubmitAnswer" Content="Submit Answer" Click="btnSubmitAnswer_Click" 
                                Width="150" Height="45" Margin="8" IsEnabled="False"/>
                        <Button x:Name="btnNextQuestion" Content="Next Question" Click="btnNextQuestion_Click" 
                                Width="150" Height="45" Margin="8" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- My Activity Log Tab -->
            <TabItem Header="Activity Log">
                <Grid Margin="15">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtActivityLog" TextWrapping="Wrap" FontSize="14" FontFamily="Consolas"/>
                    </ScrollViewer>
                    <Button Content="Refresh Log" Click="RefreshLog_Click" 
                            HorizontalAlignment="Right" VerticalAlignment="Top" Width="130" Margin="10"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>